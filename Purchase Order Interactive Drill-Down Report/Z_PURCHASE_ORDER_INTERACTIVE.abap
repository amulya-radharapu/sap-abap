REPORT Z_PURCHASE_ORDER_INTERACTIVE LINE-COUNT 20.

TABLES EKKO.

SELECT-OPTIONS S_EBELN FOR EKKO-EBELN.

TYPES: BEGIN OF TY_EKKO,
         EBELN TYPE EKKO-EBELN,
         BUKRS TYPE EKKO-BUKRS,
         ERNAM TYPE EKKO-ERNAM,
         BEDAT TYPE EKKO-BEDAT,
         BSART TYPE EKKO-BSART,
       END OF TY_EKKO.

DATA: IT_EKKO TYPE STANDARD TABLE OF TY_EKKO,
      WA_EKKO TYPE TY_EKKO.

START-OF-SELECTION.

  SELECT EBELN BUKRS ERNAM BEDAT BSART
    FROM EKKO
    INTO TABLE IT_EKKO
    WHERE EBELN IN S_EBELN.

  IF IT_EKKO IS NOT INITIAL.

    SORT IT_EKKO BY EBELN.

    LOOP AT IT_EKKO INTO WA_EKKO.

      WRITE:/ WA_EKKO-EBELN,
              WA_EKKO-BUKRS,
              WA_EKKO-ERNAM,
              WA_EKKO-BEDAT,
              WA_EKKO-BSART.

      HIDE WA_EKKO-EBELN.

    ENDLOOP.

  ENDIF.

TOP-OF-PAGE.

  WRITE:/ 'Purchase Order Details'.
  ULINE.

TOP-OF-PAGE DURING LINE-SELECTION.

  WRITE:/ 'Purchase Order Details - Secondary Screen'.
  ULINE.

AT LINE-SELECTION.

  CASE SY-LSIND.

    WHEN 1.

      SELECT EBELN, EBELP, MATNR
        FROM EKPO
        INTO TABLE @DATA(IT_EKPO)
        WHERE EBELN = @WA_EKKO-EBELN.

      IF IT_EKPO IS NOT INITIAL.

        LOOP AT IT_EKPO INTO DATA(WA_EKPO).

          WRITE:/ WA_EKPO-EBELN,
                  WA_EKPO-EBELP,
                  WA_EKPO-MATNR.

          HIDE WA_EKPO-MATNR.
        ENDLOOP.
      ENDIF.

    WHEN 2.

      SELECT MATNR, MTART, MBRSH, MATKL
        FROM MARA
        INTO TABLE @DATA(IT_MARA)
        WHERE MATNR = @WA_EKPO-MATNR.

      IF IT_MARA IS NOT INITIAL.

        LOOP AT IT_MARA INTO DATA(WA_MARA).

          WRITE:/ WA_MARA-MATNR,
                  WA_MARA-MTART,
                  WA_MARA-MBRSH,
                  WA_MARA-MATKL.

          HIDE WA_MARA-MATNR.

        ENDLOOP.

      ENDIF.

    WHEN 3.

      SELECT MATNR, WERKS
        FROM MARC
        INTO TABLE @DATA(IT_MARC)
        WHERE MATNR = @WA_MARA-MATNR.

      IF IT_MARC IS NOT INITIAL.

        LOOP AT IT_MARC INTO DATA(WA_MARC).

          WRITE:/ WA_MARC-MATNR,
                  WA_MARC-WERKS.

        ENDLOOP.

      ENDIF.

  ENDCASE.