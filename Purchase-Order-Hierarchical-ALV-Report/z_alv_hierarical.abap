CLEAR WA_FCAT.

* Setting ALV layout properties
IT_LAYOUT-EXPAND_FIELDNAME = 'EXPAND'.
IT_LAYOUT-WINDOW_TITLEBAR = 'Hierarical_ALV'.
IT_LAYOUT-LIGHTS_TABNAME = 'it_ekpo'.
IT_LAYOUT-COLWIDTH_OPTIMIZE = 'X'.

* Defining the common key field between header and item tables
WA_KEY-HEADER01 = 'Ebeln'.
WA_KEY-ITEM01 = 'Ebeln'.

* Displaying header and item data using Hierarchical Sequential ALV
CALL FUNCTION 'REUSE_ALV_HIERSEQ_LIST_DISPLAY'
  EXPORTING
    I_CALLBACK_PROGRAM = SY-CPROG
    IS_LAYOUT          = IT_LAYOUT
    IT_FIELDCAT        = IT_FCAT
    I_TABNAME_HEADER   = 'it_ekko'
    I_TABNAME_ITEM     = 'it_ekpo'
    IS_KEYINFO         = WA_KEY
  TABLES
    T_OUTTAB_HEADER    = IT_EKKO
    T_OUTTAB_ITEM      = IT_EKPO.