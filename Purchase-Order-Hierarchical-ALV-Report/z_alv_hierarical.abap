WA_FCAT-COL_POS = '8'.
WA_FCAT-FIELDNAME = 'Netpr'.
WA_FCAT-SELTEXT_M = 'Price'.
WA_FCAT-TABNAME = 'it_ekpo'.
WA_FCAT-OUTPUTLEN = '20'.
