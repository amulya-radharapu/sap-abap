CLEAR WA_FCAT.

WA_FCAT-COL_POS = '7'.
WA_FCAT-FIELDNAME = 'meins'.
WA_FCAT-SELTEXT_M = 'Po UOM'.
WA_FCAT-TABNAME = 'it_ekpo'.
WA_FCAT-OUTPUTLEN = '20'.
APPEND WA_FCAT TO IT_FCAT.
