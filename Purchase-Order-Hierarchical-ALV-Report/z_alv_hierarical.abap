REPORT Z_ALV_HIERARICAL.

TABLES EKKO.
SELECT-OPTIONS S_EBELN FOR EKKO-EBELN.

* Structure for purchase order header data
TYPES: BEGIN OF TY_EKKO,
         EBELN  TYPE EKKO-EBELN,
         LIFNR  TYPE EKKO-LIFNR,
         BEDAT  TYPE EKKO-BEDAT,
         ICON   TYPE ICON_D,
         EXPAND,
       END OF TY_EKKO.

* Structure for purchase order item data
TYPES: BEGIN OF TY_EKPO,
         EBELN TYPE EKPO-EBELN,
         EBELP TYPE EKPO-EBELP,
         MATNR TYPE EKPO-MATNR,
         MENGE TYPE EKPO-MENGE,
         MEINS TYPE EKPO-MEINS,
         NETPR TYPE EKPO-NETPR,
       END OF TY_EKPO.

DATA: IT_EKKO TYPE STANDARD TABLE OF TY_EKKO,
      WA_EKKO TYPE TY_EKKO,
      IT_EKPO TYPE STANDARD TABLE OF TY_EKPO,
      WA_EKPO TYPE TY_EKPO.

* Declarations for field catalog, layout and header-item relationship
DATA: IT_FCAT TYPE SLIS_T_FIELDCAT_ALV,
      WA_FCAT LIKE LINE OF IT_FCAT.

DATA: IT_LAYOUT TYPE SLIS_LAYOUT_ALV,
      WA_KEY    TYPE SLIS_KEYINFO_ALV.

* Fetching purchase order header data from EKKO
SELECT EBELN LIFNR BEDAT FROM EKKO INTO TABLE IT_EKKO WHERE EBELN IN S_EBELN.

* Fetching corresponding item details from EKPO
IF IT_EKKO IS NOT INITIAL.
  SELECT EBELN EBELP MATNR MENGE MEINS NETPR FROM EKPO INTO TABLE IT_EKPO FOR ALL ENTRIES IN IT_EKKO WHERE EBELN = IT_EKKO-EBELN.
ENDIF.

* Configuring field catalog for header and item columns
WA_FCAT-COL_POS = '1'.
WA_FCAT-FIELDNAME = 'Ebeln'.
WA_FCAT-SELTEXT_M = 'Po number'.
WA_FCAT-TABNAME = 'it_ekko'.
WA_FCAT-OUTPUTLEN = '20'.
WA_FCAT-KEY = 'X'.
APPEND WA_FCAT TO IT_FCAT.
CLEAR WA_FCAT.

WA_FCAT-COL_POS = '2'.
WA_FCAT-FIELDNAME = 'lifnr'.
WA_FCAT-SELTEXT_M = 'ven number'.
WA_FCAT-TABNAME = 'it_ekko'.
WA_FCAT-OUTPUTLEN = '20'.
WA_FCAT-KEY = 'X'.
APPEND WA_FCAT TO IT_FCAT.
CLEAR WA_FCAT.

WA_FCAT-COL_POS = '3'.
WA_FCAT-FIELDNAME = 'Bedat'.
WA_FCAT-SELTEXT_M = 'Po Date'.
WA_FCAT-TABNAME = 'it_ekko'.
WA_FCAT-OUTPUTLEN = '20'.
APPEND WA_FCAT TO IT_FCAT.
CLEAR WA_FCAT.

WA_FCAT-COL_POS = '4'.
WA_FCAT-FIELDNAME = 'Ebelp'.
WA_FCAT-SELTEXT_M = 'Item number'.
WA_FCAT-TABNAME = 'it_ekpo'.
WA_FCAT-OUTPUTLEN = '20'.
WA_FCAT-KEY = 'X'.
APPEND WA_FCAT TO IT_FCAT.
CLEAR WA_FCAT.

WA_FCAT-COL_POS = '5'.
WA_FCAT-FIELDNAME = 'Matnr'.
WA_FCAT-SELTEXT_M = 'Product'.
WA_FCAT-TABNAME = 'it_ekpo'.
WA_FCAT-OUTPUTLEN = '20'.
APPEND WA_FCAT TO IT_FCAT.
CLEAR WA_FCAT.

WA_FCAT-COL_POS = '6'.
WA_FCAT-FIELDNAME = 'Menge'.
WA_FCAT-SELTEXT_M = 'Po QTY'.
WA_FCAT-TABNAME = 'it_ekpo'.
WA_FCAT-OUTPUTLEN = '20'.
